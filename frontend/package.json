		"prettier-plugin-tailwindcss": "^0.6.13",
		"svelte": "^5.34.8",
		"svelte-check": "^4.2.2",
		"tailwindcss": "^4.1.10",
		"typescript": "^5.8.3",
		"vite": "^6.3.5"
	},
	"dependencies": {
		"@lucide/svelte": "^0.523.0",
		"@xyflow/svelte": "^1.1.1",
		"http-status-codes": "^2.3.0"
